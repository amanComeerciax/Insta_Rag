# SaveSort AI - Environment Variables
# Copy this file to .env.local and fill in your values

# -----------------------------------------------------------------------------
# Groq API (Primary LLM & Vision: https://console.groq.com)
# -----------------------------------------------------------------------------
# Used for:
# 1. openai/gpt-oss-120b: Ultra-fast conversational RAG and code synthesis
# 2. qwen/qwen3.8-27b: Multimodal vision extraction from carousel slides
GROQ_API_KEY=your_groq_api_key_here

# -----------------------------------------------------------------------------
# Google Gemini API (Free tier: https://aistudio.google.com/apikey)
# -----------------------------------------------------------------------------
# Used for:
# 1. Automated fallback for categorization, summarization, and vision
# 2. text-embedding-004: Semantic vector generation for pgvector search
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# Database Configuration (MongoDB Atlas - Recommended)
# -----------------------------------------------------------------------------
# Single connection string from MongoDB Atlas Dashboard (Connect -> Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.htv65hv.mongodb.net/instasaved?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# Supabase Configuration (Optional alternative: https://supabase.com)
# -----------------------------------------------------------------------------
# Found in Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key (Keep server-side only! Used for batch ingestion & admin RPC)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# -----------------------------------------------------------------------------
# Chrome Companion Extension Ingestion Secret
# -----------------------------------------------------------------------------
# Secret token to authenticate requests from your Chrome Extension to /api/import/extension
EXTENSION_API_SECRET=savesort_ext_secret_replace_with_random_string

# -----------------------------------------------------------------------------
# Clerk Authentication (https://clerk.com)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# -----------------------------------------------------------------------------
# App URL
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
